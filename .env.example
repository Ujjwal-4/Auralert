# Database path (SQLite)
DB_PATH=./data/auralert.db

# Server
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Agent brain (optional; the deterministic fallback works with none of these) ---
# Amazon Bedrock: provide AWS credentials via env vars or a profile, and enable model access in the console.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_PROFILE=auralert-dev

# OpenRouter (secondary brain). NEVER commit a real key.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
